{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AcademicCalendarSchema",
  "description": "Schema for an academic year and its terms with optional milestones and midterm breaks",
  "type": "object",
  "required": ["year_name", "start_date", "end_date", "terms"],
  "properties": {
    "year_name": {
      "type": "string",
      "description": "Label for the academic year, e.g., 2025/2026"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Start date for the academic year. (YYYY-MM-DD)"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "End date for the academic year. (YYYY-MM-DD)"
    },
    "is_current": {
      "type": "boolean",
      "description": "Whether this year should be marked as the current year in the system"
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["term_name", "start_date", "end_date"],
        "properties": {
          "term_name": { "type": "string" },
          "start_date": { "type": "string", "format": "date" },
          "end_date": { "type": "string", "format": "date" },
          "vacation_date": { "type": "string", "format": "date" },
          "resumption_date": { "type": "string", "format": "date" },
          "is_active": { "type": "boolean" },
          "midterm_breaks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start_date": { "type": "string", "format": "date" },
                "end_date": { "type": "string", "format": "date" },
                "description": { "type": "string" }
              },
              "required": ["start_date", "end_date"]
            }
          },
          "milestones": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "start_date": { "type": "string", "format": "date" },
                "end_date": { "type": "string", "format": "date" },
                "description": { "type": "string" }
              },
              "required": ["name", "start_date", "end_date"]
            }
          }
        }
      }
    },
    "notes": { "type": "string", "description": "Optional notes or metadata about the academic year" }
  }
}
